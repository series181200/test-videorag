{
  "extends": "@electron-toolkit/tsconfig/tsconfig.json",
  "include": [
    "src/**/*",
    "electron.vite.config.*"
  ],
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@/*": ["./src/*"],
      "@main/*": ["./src/main/*"],
      "@renderer/*": ["./src/renderer/*"],
      "@preload/*": ["./src/preload/*"]
    },
    "types": ["node"],
    "moduleResolution": "bundler"
  }
} 
